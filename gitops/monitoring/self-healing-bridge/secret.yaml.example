# Self-Healing Bridge Secret
# IMPORTANT: Copy to secret.yaml and fill in your GitHub PAT
# DO NOT commit secret.yaml to git
#
# GitHub PAT requirements:
#   - Fine-grained token (recommended) OR classic token
#   - Repository: dsrdantas/TC4-TM
#   - Permission: Actions (write)  — allows triggering workflow_dispatch / repository_dispatch
#
# Create at: https://github.com/settings/personal-access-tokens/new
#
# Apply: kubectl apply -f gitops/monitoring/self-healing-bridge/secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: self-healing-bridge-secret
  namespace: monitoring
type: Opaque
stringData:
  GITHUB_TOKEN: "<GITHUB_PAT_WITH_ACTIONS_WRITE>"
